<Window x:Class="TilemapCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="TileEdit"
        Height="536"
        Width="835">
    <Grid Margin="0,0,0,193">
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Header="_New Tilemap"
                              Click="ButtonNewTilemapClick" />
                    <MenuItem Header="_Open Tilemap from file"
                              Click="ButtonOpenDataClick" />
                    <MenuItem Header="_Save Tilemap"
                              Click="ButtonExportDataClick" />
                </MenuItem>
                <MenuItem Header="_Jens Petter">
                    <MenuItem Header="Portfolio"
                              Click="ButtonPortfolioClick" />
                    <MenuItem Header="Linkedin"
                              Click="ButtonLinkedinClick" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <Canvas Background="DarkGray"
                HorizontalAlignment="Left"
                Height="479"
                Margin="248,19,0,-161"
                VerticalAlignment="Top"
                Width="424">
            <TextBlock Canvas.Left="10"
                       Canvas.Top="10"
                       FontSize="20"
                       HorizontalAlignment="Left"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Height="34"
                       Width="194">
                <Run Text="Grid editor" />
                <LineBreak />
                <Run />
            </TextBlock>
            <Canvas Name="canvas1"
                    Canvas.Left="10"
                    Canvas.Top="39"
                    Height="400"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="400" />
        </Canvas>

        <Canvas Background="DarkGray"
                HorizontalAlignment="Left"
                Height="259"
                Margin="677,19,0,0"
                VerticalAlignment="Top"
                Width="142">
            <TextBlock Canvas.Left="10"
                       Canvas.Top="10"
                       FontSize="20"
                       HorizontalAlignment="Left"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Height="34"
                       Width="194">
                <Run Text="Layer editor" />
                <LineBreak />
                <Run />
            </TextBlock>
            <StackPanel Name="LayerStackPanel"
                        Canvas.Left="10"
                        Canvas.Top="44"
                        Background="Gray"
                        Orientation="Vertical"
                        Height="181"
                        Width="122" />
            <Button Canvas.Left="10"
                    Canvas.Top="230"
                    Click="AddLayer"
                    Content="Add Layer"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="76" />
        </Canvas>

        <Canvas Background="DarkGray"
                HorizontalAlignment="Left"
                Height="215"
                Margin="677,283,0,-161"
                VerticalAlignment="Top"
                Width="142">
            <TextBlock Canvas.Left="10"
                       Canvas.Top="10"
                       FontSize="20"
                       HorizontalAlignment="Left"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Height="34"
                       Width="194">
                <Run Text="Paint options" />
                <LineBreak />
                <Run />
            </TextBlock>
            <Button Canvas.Left="10"
                    Canvas.Top="49"
                    Click="SetPaintModePaint"
                    Content="Paint"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="74" />
            <Button Canvas.Left="10"
                    Canvas.Top="74"
                    Click="SetPaintModeErase"
                    Content="Erase"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="74" />
            <Button Canvas.Left="10"
                    Canvas.Top="99"
                    Click="SetPaintModeFill"
                    Content="Fill"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="74" />
            <Button Canvas.Left="10"
                    Canvas.Top="124"
                    Click="SetPaintModeDeleteFill"
                    Content="Delete Fill"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="74" />
        </Canvas>


        <Canvas Background="DarkGray"
                HorizontalAlignment="Left"
                Height="154"
                Width="243"
                Margin="0,19,0,0"
                VerticalAlignment="Top">
            <Label Canvas.Left="10"
                   Canvas.Top="35" 
                   Content="Name" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" 
                   Height="31"/>
            <Label Canvas.Left="10" 
                   Canvas.Top="62"
                   Content="Width&#xD;&#xA;" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" 
                   Height="31"/>
            <TextBlock Canvas.Left="10" 
                       Canvas.Top="10"
                       FontSize="20" 
                       HorizontalAlignment="Left" 
                       TextWrapping="Wrap" 
                       VerticalAlignment="Top" 
                       Height="34"
                       Width="223">
                <Run Text="Tilemap configurations"/>
                <LineBreak/>
                <Run/>
            </TextBlock>
            <Label Canvas.Left="10" 
                   Canvas.Top="93"
                   Content="Height&#xD;&#xA;&#xA;"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Height="31"/>
            <TextBox Name="WidthInput" 
                     Canvas.Left="85"
                     Canvas.Top="66"
                     PreviewTextInput="OnlyNumberInput" 
                     HorizontalAlignment="Left" 
                     Height="23"
                     TextWrapping="Wrap"
                     Text="11"
                     VerticalAlignment="Top"
                     Width="52"/>
            <TextBox Name="HeightInput" 
                     Canvas.Left="85"
                     Canvas.Top="93"
                     PreviewTextInput="OnlyNumberInput" 
                     HorizontalAlignment="Left"
                     Height="23"
                     TextWrapping="Wrap"
                     Text="11"
                     VerticalAlignment="Top"
                     Width="52"/>
            <Button Click="CreateGridRoom"
                    Canvas.Left="10"
                    Canvas.Top="124"
                    Content="Create grid"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" 
                    Width="194"/>
            <TextBox Name="TileMapNameInput"
                     Canvas.Left="85"
                     Canvas.Top="39"
                     HorizontalAlignment="Left"
                     Height="23"
                     TextWrapping="Wrap"
                     Text="Tilemap"
                     VerticalAlignment="Top"
                     Width="119"/>
        </Canvas>

        <Canvas Background="DarkGray" 
                HorizontalAlignment="Left"
                Height="320"
                Margin="0,178,0,-161"
                VerticalAlignment="Top"
                Width="243">
            <TextBlock FontSize="20"
                       HorizontalAlignment="Left"
                       Margin="10,10,0,0"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top" 
                       Height="34"
                       Width="194">
                <Run Text="TileSet editor"/>
                <LineBreak/>
                <Run/>
            </TextBlock>

            <Label Canvas.Left="10"
                   Canvas.Top="44"
                   Content="Tile width" 
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Height="31"/>
            <Label Canvas.Left="10"
                   Canvas.Top="72"
                   Content="Tile height"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Height="31"/>
            <TextBox Name="TileWidthInput" 
                     Canvas.Left="85"
                     Canvas.Top="48"
                     PreviewTextInput="OnlyNumberInput"
                     HorizontalAlignment="Left" 
                     Height="23"
                     TextWrapping="Wrap"
                     Text="40"
                     VerticalAlignment="Top"
                     Width="52"/>
            <TextBox Name="TileHeightInput" 
                     Canvas.Left="85"
                     Canvas.Top="75"
                     PreviewTextInput="OnlyNumberInput" 
                     HorizontalAlignment="Left"
                     Height="23"
                     TextWrapping="Wrap"
                     Text="40"
                     VerticalAlignment="Top"
                     Width="52"/>
            <Button Click="ButtonLoadTileSetFromDisk_Click"
                    Canvas.Left="10"
                    Canvas.Top="106"
                    Content="Load TileSet from disk"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="194"/>
            <Canvas Height="170"
                    Canvas.Left="10"
                    Canvas.Top="134"
                    Background="Gray"
                    HorizontalAlignment="Left" 
                    Name="TileSetCanvas"
                    VerticalAlignment="Top"
                    Width="220"/>
        </Canvas>
    </Grid>
</Window>